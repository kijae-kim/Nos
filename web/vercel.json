{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "feat/*": false,
      "fix/*": false,
      "docs/*": false
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
