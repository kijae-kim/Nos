# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# 개발 중에는 1, 배포 서버에서는 0
DJANGO_DEBUG=1
# 배포 시 필수. 생성: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 소셜 로그인 (비워 두면 해당 버튼이 표시되지 않습니다)
# 카카오: https://developers.kakao.com  → REST API 키
#   Redirect URI: http://localhost:8000/accounts/kakao/login/callback/
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 구글: https://console.cloud.google.com → OAuth 클라이언트 ID
#   Redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 업로드 사진 저장소 (배포용). 비워 두면 개발용으로 web/media/ 에 저장한다.
# MEDIA_BUCKET_NAME=
# MEDIA_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   (AWS S3면 비워 둔다)
# MEDIA_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 배포 DB (Neon Postgres). 비워 두면 개발용 SQLite(web/db.sqlite3)를 쓴다.
# 앱(Vercel)에는 풀링 주소(-pooler), 자기 컴퓨터에서 migrate 할 때는 직접 연결 주소를 쓴다.
# DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require
# 배포 도메인 (쉼표로 여러 개). 예: nos-xxxx.vercel.app
# DJANGO_ALLOWED_HOSTS=nos-xxxx.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nos-xxxx.vercel.app

# 기념일 알림 (웹 푸시). 비워 두면 알림 기능이 숨겨진다.
# 만들기: python web/manage.py make_vapid_keys  (출력을 이 파일에 붙여 넣고 VAPID_SUBJECT 를 내 이메일로)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Vercel Cron 이 알림 주소를 부를 때 쓰는 비밀 값 (아무 긴 문자열)
# CRON_SECRET=
