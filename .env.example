# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# 개발 중에는 1, 배포 서버에서는 0
DJANGO_DEBUG=1
# 배포 시 필수. 생성: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 소셜 로그인 (비워 두면 해당 버튼이 표시되지 않습니다)
# 카카오: https://developers.kakao.com  → REST API 키
#   Redirect URI: http://localhost:8000/accounts/kakao/login/callback/
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 구글: https://console.cloud.google.com → OAuth 클라이언트 ID
#   Redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
